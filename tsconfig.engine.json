{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "ES2023",
    /* The engine runs in the browser and in Node scripts. WebWorker gives the globals both have
       (URL, TextEncoder, crypto, console) without the DOM; types: [] keeps Node's globals out. */
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "skipLibCheck": true,

    /* Node resolution: scripts run these files directly, so relative imports need the .ts extension. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/engine"],
  "exclude": ["src/engine/**/*.test.ts"]
}

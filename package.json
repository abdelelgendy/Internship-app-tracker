{
  "name": "shortlist",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first job-search copilot. It prepares, explains, reminds and records; you submit every application yourself.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:jobhunter": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import-jobhunter.ts",
    "scan": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/scan.ts",
    "score": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/score.ts",
    "digest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/digest.ts",
    "export:csv": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/export-csv.ts",
    "prefill": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prefill.ts",
    "check:private": "node scripts/check-private.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
  }
}
